{"מִצְאוּ זוּגוֹת זֵהִים":["39a700cc"],"אֵיפֹה אוֹתָהּ אוֹת בִּכְתַב יָד?":["5b8787ac"],"גִּרְרוּ לַצַּד הַנָּכוֹן":["6c1e3de2"],"בְּאֵיזֶה צְלִיל מַתְחִילָה הַמִּלָּה?":["7f14e9ca"],"לַחֲצוּ עַל הַחֲפַרְפֶּרֶת הַנְּכוֹנָה":["64a599cc"],"אֵיפֹה הָאוֹת כָּף?":["c16b38e1"],"אֵיזוֹ תְּמוּנָה מַתְאִימָה לַמִּלָּה?":["712120f1"],"סוֹבְבוּ אֶת הַגַּלְגַּל":["7c6da36a"],"גִּרְרוּ כָּל אוֹת לַמִּלָּה":["cdf6d601"],"אֵיזוֹ מִלָּה מַתְאִימָה לַתְּמוּנָה?":["3df5fb21"],"אֵיפֹה הַחַיּוֹת?":["fc6e22ea"],"הָזִיזוּ אֶת הַמָּטוֹס":["13dff827"],"אֵיפֹה הָאוֹת הֵא?":["4154a912"],"אֵיזוֹ אוֹת חֲסֵרָה?":["fc4d284d"],"מָה בַּתְּמוּנָה?":["a1e04fa0"],"כַּמָּה צְלִילִים יֵשׁ בַּמִּלָּה?":["3eefc39c"],"מִתְחוּ קַו אֶל הָאוֹת הַזֵּהָה":["4d95794a"],"אֵיזוֹ תְּמוּנָה מַתְאִימָה לַמִּשְׁפָּט?":["7887fea5"],"מִי מַתְחִיל בְּאוֹתוֹ צְלִיל?":["3ec0a73d"],"בְּאֵיזוֹ אוֹת מַתְחִילָה הַמִּלָּה?":["c575af17"],"בַּחֲרוּ אֶת הַתְּשׁוּבָה הַנְּכוֹנָה":["05551417"],"סַדְּרוּ אֶת הָאוֹתִיּוֹת לְמִלָּה":["2ece57ec"],"אֵיזוֹ אוֹת רְגִילָה מַתְאִימָה?":["f6b1b407"],"בְּאֵיזוֹ אוֹת נִגְמֶרֶת הַמִּלָּה?":["5cb110e3"],"מַיְּנוּ כָּל פְּרִיט לַקְּבוּצָה שֶׁלּוֹ":["54bc3f01"],"לַחֲצוּ עַל הַחֲפִיסָה":["acf50e6c"],"אֵיזוֹ מִלָּה מִתְחָרֶזֶת?":["85ef7af8"],"אֵיפֹה הָאוֹת דָּלֶת?":["4156e7a9"],"אֵיפֹה הָאוֹת לָמֶד?":["416830ca"],"תִּפְסוּ אֶת הַפַּרְפַּר הַנָּכוֹן":["5e892020"],"אֵיפֹה הַמִּלִּים שֶׁנִּגְמָרוֹת בָּאוֹת הַזֹּאת?":["bd03d7b2"],"אֵיזוֹ תְּמוּנָה מַתְאִימָה לָאוֹת?":["9ca0b2cd"],"גִּרְרוּ כָּל דָּג לֶחָבֵר":["beac4e08"],"הָזִיזוּ אֶת הַדְּמוּת וְהִזָּהֲרוּ מֵהַחַיְזָרִים":["68138971"],"אֵיפֹה הָאוֹת זַיִן?":["c14f6264"],"מִצְאוּ אֶת הָאוֹת חֵית":["cc40622e"],"אֵיפֹה הָאוֹת רֵישׁ?":["c14ae536"],"אֵיפֹה הָאוֹת שִׁין?":["4147dd1f"],"מִצְאוּ אֶת הָאוֹת תָּו":["d94076a5"],"מָה יוֹצֵא דֹּפֶן וְלָמָּה?":["95e5ed52"],"אֵיפֹה הָאוֹת מֵם?":["4163b39c"],"הַפִּילוּ לַקָּרוֹן הַנָּכוֹן":["1f4facf1"],"אֵיפֹה הָאוֹת עַיִן?":["413216d0"],"אֵיפֹה הָאוֹת אָלֶף?":["c15e6cee"],"אֵיפֹה הָאוֹת בֵּית?":["c15c2e57"],"אֵיפֹה ה